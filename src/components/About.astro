---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { profile, education } from '../data/site';

const approach = [
  {
    icon: 'layers',
    title: 'One codebase, two platforms',
    text: 'Kotlin Multiplatform & Compose Multiplatform — shared logic and UI across Android and iOS.',
  },
  {
    icon: 'code',
    title: 'Native craftsmanship',
    text: 'Deep native roots — Jetpack Compose on Android, Swift & SwiftUI on iOS.',
  },
  {
    icon: 'rocket',
    title: 'Shipped & maintained',
    text: 'Apps published, released and supported on Google Play and the App Store.',
  },
  {
    icon: 'trophy',
    title: 'Award-winning work',
    text: '1st place at the President Tech Award — a $100,000 grand prize.',
  },
];
---

<Section
  id="about"
  eyebrow="About"
  icon="sparkles"
  title="A mobile developer who ships"
>
  <div class="grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr]">
    <!-- portrait -->
    <div class="reveal mx-auto w-full max-w-[20rem] lg:mx-0">
      <div class="relative">
        <div
          class="absolute -inset-3 -z-10 rounded-[1.75rem] bg-gradient-to-br from-accent/40 to-accent-2/25 opacity-60 blur-2xl"
        >
        </div>
        <img
          src={profile.photo}
          alt={`Portrait of ${profile.name}`}
          width="900"
          height="1157"
          class="w-full rounded-2xl border border-line-strong"
        />
        <div
          class="glass absolute inset-x-3 bottom-3 flex items-center gap-2 rounded-xl px-3 py-2"
        >
          <Icon name="map-pin" size={15} class="text-accent-soft" />
          <span class="text-sm font-medium text-ink">{profile.location}</span>
          {
            profile.available && (
              <span class="ml-auto flex items-center gap-1.5 text-xs font-medium text-emerald-300">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" />
                Available
              </span>
            )
          }
        </div>
      </div>
    </div>

    <!-- summary + education -->
    <div class="reveal" data-delay="1">
      <div class="space-y-4">
        {
          profile.summary.map((p) => (
            <p class="text-base leading-relaxed text-ink-soft sm:text-[1.05rem]">{p}</p>
          ))
        }
      </div>

      <div class="card mt-8 flex items-start gap-4 p-5">
        <div
          class="grid h-11 w-11 shrink-0 place-items-center rounded-lg border border-line bg-elevated text-accent-soft"
        >
          <Icon name="graduation-cap" size={22} />
        </div>
        <div>
          <h3 class="font-semibold text-ink">{education.degree}</h3>
          <p class="text-sm text-ink-muted">{education.place}</p>
          <div class="mt-2 flex flex-wrap gap-2">
            <span
              class="rounded-md border border-line bg-white/5 px-2 py-0.5 text-xs font-medium text-ink-soft"
              >{education.honors}</span
            >
            <span
              class="rounded-md border border-accent/30 bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent-soft"
              >GPA {education.gpa}</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- approach grid -->
  <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      approach.map((a, i) => (
        <div class="card reveal p-5" data-delay={(i % 4) + 1}>
          <div class="mb-3 inline-grid h-10 w-10 place-items-center rounded-lg border border-line bg-elevated text-accent-soft">
            <Icon name={a.icon} size={20} />
          </div>
          <h3 class="text-sm font-semibold text-ink">{a.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{a.text}</p>
        </div>
      ))
    }
  </div>
</Section>
