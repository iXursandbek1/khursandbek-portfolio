---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { awards } from '../data/site';

const a = awards.headline;
---

<Section
  id="awards"
  eyebrow="Recognition"
  icon="trophy"
  title="Awards & achievements"
  subtitle="Work that's been recognised on the national stage."
>
  <!-- featured award -->
  <div class="card reveal overflow-hidden !p-0">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr]">
      <!-- certificate photo -->
      <button
        type="button"
        data-zoom
        data-src={awards.gallery[0].src}
        data-caption={awards.gallery[0].caption}
        class="group relative min-h-[18rem] cursor-pointer overflow-hidden border-b border-line lg:border-b-0 lg:border-r"
      >
        <img
          src={awards.gallery[0].src}
          alt={awards.gallery[0].alt}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <span
          class="absolute inset-0 bg-gradient-to-t from-bg/80 via-transparent to-transparent"
        ></span>
        <span
          class="absolute bottom-3 right-3 grid h-9 w-9 place-items-center rounded-full bg-bg/70 text-ink opacity-0 backdrop-blur transition-opacity group-hover:opacity-100"
        >
          <Icon name="external" size={16} />
        </span>
      </button>

      <!-- details -->
      <div class="p-6 sm:p-10">
        <p class="eyebrow text-amber-300">
          <Icon name="trophy" size={15} />
          1st Place · {a.organizers}
        </p>

        <div class="mt-4 flex items-end gap-3">
          <span
            class="bg-gradient-to-br from-amber-200 via-amber-300 to-amber-500 bg-clip-text text-[clamp(3rem,9vw,5rem)] font-bold leading-none tracking-tight text-transparent"
          >
            {a.prize}
          </span>
          <span
            class="mb-2 rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-xs font-semibold text-amber-300"
          >
            Grand Prize
          </span>
        </div>

        <h3 class="mt-4 text-xl font-bold text-ink sm:text-2xl">
          {a.title}
        </h3>
        <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">
          {a.description}
        </p>

        <div class="mt-5 flex flex-wrap gap-2">
          <span
            class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-white/[0.03] px-3 py-1.5 text-sm font-medium text-ink-soft"
          >
            <Icon name="rocket" size={15} class="text-accent-soft" />
            Project: {a.project}
          </span>
          <span
            class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-white/[0.03] px-3 py-1.5 text-sm font-medium text-ink-soft"
          >
            <Icon name="sparkles" size={15} class="text-accent-soft" />
            {a.category}
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- gallery -->
  <h3 class="reveal mt-12 text-sm font-semibold uppercase tracking-wider text-ink-muted">
    From the Grand Final
  </h3>
  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
    {
      awards.gallery.map((photo, i) => (
        <button
          type="button"
          data-zoom
          data-src={photo.src}
          data-caption={photo.caption}
          class="reveal group relative aspect-[3/4] cursor-pointer overflow-hidden rounded-xl border border-line"
          data-delay={(i % 4) + 1}
        >
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <span class="absolute inset-0 bg-gradient-to-t from-bg via-bg/10 to-transparent opacity-80" />
          <span class="absolute inset-x-3 bottom-3 text-left text-xs font-medium text-ink">
            {photo.caption}
          </span>
        </button>
      ))
    }
    <!-- placeholder for upcoming photos -->
    <div
      class="reveal grid aspect-[3/4] place-items-center rounded-xl border border-dashed border-line text-center"
      data-delay="3"
    >
      <span class="px-3 text-xs text-ink-muted">
        <Icon name="sparkles" size={18} class="mx-auto mb-2 text-ink-muted" />
        More photos<br />coming soon
      </span>
    </div>
  </div>

  <!-- lightbox -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-bg/90 p-4 backdrop-blur-md"
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
  >
    <button
      id="lb-close"
      type="button"
      aria-label="Close"
      class="glass absolute right-4 top-4 grid h-11 w-11 place-items-center rounded-full text-ink"
    >
      <Icon name="close" size={20} />
    </button>
    <figure class="flex max-h-full max-w-3xl flex-col items-center gap-3">
      <img id="lb-img" src="" alt="" class="max-h-[80vh] rounded-xl object-contain" />
      <figcaption id="lb-cap" class="text-sm text-ink-soft"></figcaption>
    </figure>
  </div>
</Section>

<script>
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lb-img') as HTMLImageElement | null;
  const lbCap = document.getElementById('lb-cap');
  const closeBtn = document.getElementById('lb-close');

  const open = (src: string, cap: string) => {
    if (!lb || !lbImg) return;
    lbImg.src = src;
    lbImg.alt = cap;
    if (lbCap) lbCap.textContent = cap;
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };
  const close = () => {
    if (!lb) return;
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    document.body.style.overflow = '';
  };

  document.querySelectorAll<HTMLElement>('[data-zoom]').forEach((el) => {
    el.addEventListener('click', () =>
      open(el.dataset.src || '', el.dataset.caption || '')
    );
  });
  closeBtn?.addEventListener('click', close);
  lb?.addEventListener('click', (e) => {
    if (e.target === lb) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>
