---
import Section from './Section.astro';
import { skillGroups } from '../data/site';
---

<Section
  id="skills"
  eyebrow="Toolkit"
  icon="zap"
  title="Skills & technologies"
  subtitle="The stack I reach for to design, build and ship production mobile apps."
>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      skillGroups.map((g, i) => (
        <div class="card reveal p-5" data-delay={(i % 4) + 1}>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-accent-soft">
            {g.title}
          </h3>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {g.items.map((item) => (
              <li class="rounded-md border border-line bg-white/[0.03] px-2.5 py-1 text-[13px] font-medium text-ink-soft transition-colors hover:border-line-strong hover:text-ink">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
