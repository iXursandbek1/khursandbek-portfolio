---
/* A CSS phone frame showing a stylised app screen themed by the app's colour.
   Drop a real screenshot into /public/images/projects and pass `shot` to
   replace the stylised screen with the photo. */
interface Props {
  name: string;
  color: string;
  tagline?: string;
  shot?: string;
  imgId?: string;
}
const { name, color, tagline = '', shot, imgId } = Astro.props;
const initial = name.charAt(0);
---

<div class="mx-auto w-[230px] sm:w-[260px]">
  <div
    class="relative aspect-[9/19] rounded-[2.6rem] border border-line-strong bg-[#0c0c0e] p-2.5 shadow-[0_30px_80px_-30px_rgba(0,0,0,0.9)]"
    style={`--app:${color}`}
  >
    <!-- ambient screen glow -->
    <div
      class="absolute -inset-6 -z-10 rounded-full opacity-40 blur-3xl"
      style={`background:radial-gradient(circle,${color},transparent 70%)`}
    >
    </div>

    <!-- dynamic island -->
    <div
      class="absolute left-1/2 top-3 z-20 h-5 w-20 -translate-x-1/2 rounded-full bg-black"
    >
    </div>

    <div class="h-full w-full overflow-hidden rounded-[2rem] bg-[#0e0e11]">
      {
        shot ? (
          <img
            id={imgId}
            src={`/images/projects/${shot}`}
            alt={`${name} app screenshot`}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-opacity duration-300"
          />
        ) : (
          <div class="flex h-full flex-col">
            {/* status bar */}
            <div class="flex items-center justify-between px-5 pt-4 text-[10px] font-semibold text-white/80">
              <span>9:41</span>
              <span class="flex gap-1">
                <span class="h-2.5 w-2.5 rounded-[2px] bg-white/30" />
                <span class="h-2.5 w-2.5 rounded-[2px] bg-white/30" />
                <span class="h-2.5 w-4 rounded-[3px] bg-white/50" />
              </span>
            </div>

            {/* app header */}
            <div class="flex items-center gap-2.5 px-4 pt-4">
              <span
                class="grid h-9 w-9 place-items-center rounded-xl text-base font-bold text-white"
                style={`background:linear-gradient(140deg,${color},${color}99)`}
              >
                {initial}
              </span>
              <span class="flex-1">
                <span class="block text-[13px] font-bold text-white">{name}</span>
                {tagline && (
                  <span class="block text-[9px] text-white/45">{tagline}</span>
                )}
              </span>
              <span class="h-7 w-7 rounded-full bg-white/[0.06]" />
            </div>

            {/* hero card */}
            <div
              class="mx-4 mt-4 rounded-2xl p-3.5"
              style={`background:linear-gradient(140deg,${color},${color}77)`}
            >
              <span class="block h-1.5 w-10 rounded-full bg-white/40" />
              <span class="mt-2 block h-2.5 w-28 rounded-full bg-white/85" />
              <span class="mt-1.5 block h-2.5 w-20 rounded-full bg-white/55" />
              <span class="mt-3 inline-block rounded-full bg-white/90 px-3 py-1 text-[8px] font-bold text-black">
                Open
              </span>
            </div>

            {/* list rows */}
            <div class="mt-4 space-y-2.5 px-4">
              {[0, 1, 2].map((r) => (
                <div class="flex items-center gap-2.5 rounded-xl bg-white/[0.04] p-2.5">
                  <span
                    class="h-7 w-7 shrink-0 rounded-lg"
                    style={`background:${color}33`}
                  />
                  <span class="flex-1">
                    <span class="block h-2 w-2/3 rounded-full bg-white/30" />
                    <span class="mt-1.5 block h-2 w-1/3 rounded-full bg-white/15" />
                  </span>
                  <span
                    class="h-4 w-4 rounded-full"
                    style={r === 0 ? `background:${color}` : 'background:rgba(255,255,255,0.1)'}
                  />
                </div>
              ))}
            </div>

            {/* bottom nav */}
            <div
              class="mt-auto flex items-center justify-around border-t border-white/5 px-4 py-3"
            >
              {[0, 1, 2, 3].map((n) => (
                <span
                  class="h-5 w-5 rounded-md"
                  style={
                    n === 0
                      ? `background:${color}`
                      : 'background:rgba(255,255,255,0.08)'
                  }
                />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</div>
