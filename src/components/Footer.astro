---
import Icon from './Icon.astro';
import { profile, navLinks } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="relative mt-10 border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <!-- brand -->
      <div class="max-w-xs">
        <a href="#top" class="flex items-center gap-2.5" aria-label="Back to top">
          <span
            class="grid h-9 w-9 place-items-center rounded-lg border border-line bg-elevated text-sm font-bold text-accent-soft"
            >K</span
          >
          <span class="text-sm font-semibold tracking-tight text-ink"
            >{profile.name}</span
          >
        </a>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">
          {profile.role} based in {profile.location}.
        </p>
      </div>

      <!-- nav -->
      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
        {
          navLinks.map((l) => (
            <a
              href={l.href}
              class="text-sm text-ink-soft transition-colors hover:text-ink"
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <!-- socials -->
      <div class="flex gap-2">
        <a
          href={`mailto:${profile.email}`}
          aria-label="Email"
          class="glass grid h-10 w-10 place-items-center rounded-lg text-ink-soft transition-colors hover:text-ink"
        >
          <Icon name="mail" size={18} />
        </a>
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="glass grid h-10 w-10 place-items-center rounded-lg text-ink-soft transition-colors hover:text-ink"
        >
          <Icon name="linkedin" size={18} />
        </a>
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="glass grid h-10 w-10 place-items-center rounded-lg text-ink-soft transition-colors hover:text-ink"
        >
          <Icon name="github" size={18} />
        </a>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col-reverse items-center gap-3 border-t border-line pt-6 text-xs text-ink-muted sm:flex-row sm:justify-between"
    >
      <p>© {year} {profile.name}. All rights reserved.</p>
      <p class="flex items-center gap-1.5">
        Built with
        <span class="text-ink-soft">Astro</span>
        &amp;
        <span class="text-ink-soft">Tailwind CSS</span>
      </p>
    </div>
  </div>
</footer>
