---
import Icon from './Icon.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  icon?: string;
  subtitle?: string;
}
const { id, eyebrow, title, icon, subtitle } = Astro.props;
---

<section
  id={id}
  class="relative mx-auto max-w-6xl scroll-mt-24 px-5 py-20 sm:px-8 sm:py-28"
>
  <header class="reveal max-w-2xl">
    <p class="eyebrow">
      {icon && <Icon name={icon} size={15} />}
      {eyebrow}
    </p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-[2.6rem] sm:leading-tight">
      {title}
    </h2>
    {subtitle && <p class="mt-3 text-base leading-relaxed text-ink-soft">{subtitle}</p>}
  </header>

  <div class="mt-12">
    <slot />
  </div>
</section>
