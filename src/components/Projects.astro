---
import fs from 'node:fs';
import Section from './Section.astro';
import Icon from './Icon.astro';
import { projects, projectGroups, type Project } from '../data/site';

const byId: Record<string, Project> = Object.fromEntries(
  projects.map((p) => [p.id, p])
);

const colors: Record<string, string> = {
  romchi: '#6366f1',
  oynachi: '#3b82f6',
  yalla: '#f59e0b',
  'royal-taxi': '#f5b50a',
  glogistics: '#10b981',
  yestms: '#0ea5e9',
  'muallimi-soniy': '#14b8a6',
};

const linkIcon: Record<string, string> = {
  play: 'google',
  apple: 'apple',
  web: 'external',
};

// keep only screenshots that actually exist on disk
const resolveShots = (p: Project): string[] =>
  (p.shots ?? (p.shot ? [p.shot] : [])).filter((s) =>
    fs.existsSync(`public/images/projects/${s}`)
  );
---

<Section
  id="projects"
  eyebrow="Work"
  icon="rocket"
  title="Selected projects"
  subtitle="Production apps I've designed, built and shipped — grouped by the company I built them with."
>
  <div class="space-y-14">
    {
      projectGroups.map((group) => (
        <div>
          {/* company header */}
          <div class="reveal mb-6 border-l-2 border-accent/60 pl-4">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h3 class="text-xl font-bold text-ink">{group.company}</h3>
              <span class="text-sm text-ink-muted">
                {group.role} · {group.period}
              </span>
            </div>
            <p class="mt-1 max-w-2xl text-sm leading-relaxed text-ink-soft">
              {group.note}
            </p>
          </div>

          {/* project cards */}
          <div class="grid gap-4 sm:grid-cols-2">
            {group.projectIds.map((pid, idx) => {
              const p = byId[pid];
              if (!p) return null;
              const shots = resolveShots(p);
              const color = colors[p.id] ?? '#6366f1';
              const framed = p.display !== 'image';
              return (
                <article
                  class="card reveal flex flex-col overflow-hidden"
                  data-delay={(idx % 2) + 1}
                >
                  {/* showcase */}
                  <div
                    class="relative flex h-80 items-center justify-center overflow-hidden border-b border-line"
                    style={`background:radial-gradient(ellipse 70% 58% at 50% 38%, ${color}33, transparent 75%)`}
                  >
                    {shots.length > 0 ? (
                      framed ? (
                        <div class="rounded-[1.5rem] border border-line-strong bg-[#0c0c0e] p-1.5 shadow-[0_25px_60px_-20px_rgba(0,0,0,0.9)]">
                          <img
                            id={`shot-${p.id}`}
                            src={`/images/projects/${shots[0]}`}
                            alt={`${p.name} app screenshot`}
                            loading="lazy"
                            decoding="async"
                            class="h-[17rem] w-auto rounded-[1.1rem]"
                          />
                        </div>
                      ) : (
                        <img
                          id={`shot-${p.id}`}
                          src={`/images/projects/${shots[0]}`}
                          alt={`${p.name} app screenshot`}
                          loading="lazy"
                          decoding="async"
                          class="h-[18rem] w-auto rounded-2xl border border-line-strong shadow-[0_25px_60px_-20px_rgba(0,0,0,0.9)]"
                        />
                      )
                    ) : (
                      <div class="flex flex-col items-center gap-3 text-center">
                        <span
                          class="grid h-16 w-16 place-items-center rounded-2xl text-2xl font-bold text-white"
                          style={`background:linear-gradient(140deg,${color},${color}88)`}
                        >
                          {p.name.charAt(0)}
                        </span>
                        <span class="text-xs text-ink-muted">
                          Screenshots coming soon
                        </span>
                      </div>
                    )}
                  </div>

                  {/* thumbnail switcher */}
                  {shots.length > 1 && (
                    <div class="flex flex-wrap gap-1.5 px-5 pt-4" data-thumbs>
                      {shots.map((s, i) => (
                        <button
                          type="button"
                          data-target={`shot-${p.id}`}
                          data-src={`/images/projects/${s}`}
                          aria-label={`${p.name} screenshot ${i + 1}`}
                          class:list={[
                            'h-12 w-[1.7rem] overflow-hidden rounded border border-line opacity-50 transition-all duration-200 hover:opacity-100',
                            '[&.is-active]:border-accent [&.is-active]:opacity-100',
                            i === 0 && 'is-active',
                          ]}
                        >
                          <img
                            src={`/images/projects/${s}`}
                            alt=""
                            loading="lazy"
                            class="h-full w-full object-cover"
                          />
                        </button>
                      ))}
                    </div>
                  )}

                  {/* content */}
                  <div class="flex flex-1 flex-col gap-3 p-5">
                    <div class="flex flex-wrap items-center gap-2">
                      <h4 class="text-lg font-bold text-ink">{p.name}</h4>
                      {p.award && (
                        <span class="inline-flex items-center gap-1 rounded-full border border-amber-400/30 bg-amber-400/10 px-2 py-0.5 text-[10px] font-semibold text-amber-300">
                          <Icon name="trophy" size={11} />
                          Award winner
                        </span>
                      )}
                    </div>
                    <p class="text-sm font-medium" style={`color:${color}`}>
                      {p.tagline}
                    </p>
                    <p class="text-sm leading-relaxed text-ink-soft">
                      {p.description}
                    </p>
                    {p.highlights && p.highlights.length > 0 && (
                      <ul class="space-y-1.5">
                        {p.highlights.slice(0, 3).map((h) => (
                          <li class="flex items-start gap-2 text-sm leading-snug text-ink-soft">
                            <span
                              class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full"
                              style={`background:${color}`}
                            />
                            <span>{h}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                    <div class="flex flex-wrap gap-1.5">
                      {p.tech.slice(0, 6).map((t) => (
                        <span class="rounded border border-line bg-white/[0.03] px-2 py-0.5 text-[11px] font-medium text-ink-muted">
                          {t}
                        </span>
                      ))}
                    </div>
                    <div class="mt-auto flex flex-wrap items-center gap-2 pt-1">
                      {p.links.map((l) => (
                        <a
                          href={l.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="glass inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-ink transition-colors hover:border-line-strong"
                        >
                          <Icon name={linkIcon[l.type]} size={14} />
                          {l.label}
                        </a>
                      ))}
                      {p.note && p.links.length === 0 && (
                        <span class="text-xs italic text-ink-muted">{p.note}</span>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>
</Section>

<script>
  // screenshot switcher: clicking a thumbnail swaps the showcase image
  document.querySelectorAll<HTMLElement>('[data-thumbs]').forEach((group) => {
    const thumbs = group.querySelectorAll<HTMLElement>('[data-target]');
    thumbs.forEach((t) => {
      t.addEventListener('click', () => {
        const img = document.getElementById(
          t.dataset.target || ''
        ) as HTMLImageElement | null;
        if (img && t.dataset.src) img.src = t.dataset.src;
        thumbs.forEach((x) => x.classList.toggle('is-active', x === t));
      });
    });
  });
</script>
