  layers: '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5M3 17l9 5 9-5"/>',
  check: '<path d="M5 12.5 10 17 19 7"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  rocket:
    '<path d="M5 15c-1.5 1.5-2 5-2 5s3.5-.5 5-2M9 11a8 8 0 0 1 8-8c2 0 3 1 3 3a8 8 0 0 1-8 8M9 11l4 4M9 11 5.5 9.5M13 15l1.5 3.5"/>',
  zap: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>',
  briefcase:
    '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
  'graduation-cap': '<path d="m12 4 10 5-10 5L2 9l10-5Z"/><path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/>',
};

const brand: Record<string, string> = {
  github:
    '<path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.37-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.91v2.83c0 .27.18.6.69.49A10.27 10.27 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/>',
  linkedin:
    '<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21H9V9Z"/>',
  apple:
    '<path d="M16.36 12.78c.03 3.18 2.79 4.24 2.82 4.25-.02.07-.44 1.52-1.46 3.01-.88 1.29-1.79 2.58-3.23 2.6-1.41.03-1.86-.83-3.48-.83-1.61 0-2.12.81-3.45.86-1.39.05-2.45-1.39-3.34-2.68-1.81-2.64-3.2-7.45-1.34-10.71.92-1.61 2.57-2.64 4.36-2.66 1.36-.03 2.65.92 3.48.92.84 0 2.4-1.14 4.05-.97.69.03 2.62.28 3.86 2.1-.1.06-2.31 1.35-2.28 4.03M13.7 4.4c.74-.9 1.24-2.15 1.1-3.4-1.07.04-2.36.71-3.12 1.61-.68.8-1.28 2.07-1.12 3.29 1.19.09 2.4-.6 3.14-1.5"/>',
  google:
    '<path d="M3.6 6.3 11 12 3.6 17.7C3.2 17.3 3 16.7 3 16V8c0-.7.2-1.3.6-1.7Zm1.5-1L13 10l2.5-1.9-9-5.2c-.5-.3-1-.3-1.4 0Zm10.7 5.6L18 12l-2.2 1.1L13.6 12l1.2-1.1Zm-1.3 2.9L13 14l-7.9 4.2c.4.3 1 .3 1.4 0l9-5.2Z"/>',
  telegram:
    '<path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/>',
};

const isBrand = name in brand;
const body = isBrand ? brand[name] : (stroke[name] ?? '');
---

{
  isBrand ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="currentColor"
      class={cls}
      aria-hidden="true"
      set:html={body}
    />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={cls}
      aria-hidden="true"
      set:html={body}
    />
  )
}
